-- ============================================================
-- МОДУЛЬ: SCANNER
-- ============================================================
local Scanner = {}
Scanner.enabled = false
Scanner.window  = nil
Scanner.scroll  = nil

function Scanner.Init()
    local win = Instance.new("Frame")
    win.Name = "ScannerWindow"
    win.Size = UDim2.new(0, 220, 0, 300)
    win.Position = UDim2.new(1, -230, 0, 100)
    win.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    win.BorderSizePixel = 2
    win.BorderColor3 = Color3.fromRGB(0, 255, 100)
    win.Visible = false
    win.Parent = gui
    Scanner.window = win

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = win

    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, 0, 0, 28)
    t.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
    t.Text = "СКАНЕР РУК"
    t.TextColor3 = Color3.new(1, 1, 1)
    t.Font = Enum.Font.GothamBold
    t.TextSize = 15
    t.Parent = win

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, -10, 1, -38)
    scroll.Position = UDim2.new(0, 5, 0, 33)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 6
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.Parent = win
    Scanner.scroll = scroll

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 4)
    layout.Parent = scroll

    spawn(function()
        while task.wait(0.5) do
            if Scanner.enabled then
                for _, c in pairs(scroll:GetChildren()) do
                    if c:IsA("TextLabel") then c:Destroy() end
                end

                local any = false
                for _, plr in pairs(Players:GetPlayers()) do
                    local char = plr.Character
                    if not char then continue end

                    local held = {}
                    for _, t2 in pairs(char:GetChildren()) do
                        if t2:IsA("Tool") then table.insert(held, "[РУКА] " .. t2.Name) end
                    end

                    local bp = plr:FindFirstChildOfClass("Backpack")
                    if bp then
                        for _, t2 in pairs(bp:GetChildren()) do
                            if t2:IsA("Tool") then table.insert(held, "[СУМКА] " .. t2.Name) end
                        end
                    end

                    if #held > 0 then
                        any = true
                        local lbl = Instance.new("TextLabel")
                        lbl.Size = UDim2.new(1, 0, 0, 0)
                        lbl.AutomaticSize = Enum.AutomaticSize.Y
                        lbl.BackgroundTransparency = 1
                        lbl.TextColor3 = Color3.fromRGB(0, 255, 100)
                        lbl.Font = Enum.Font.Code
                        lbl.TextSize = 13
                        lbl.TextXAlignment = Enum.TextXAlignment.Left
                        lbl.TextWrapped = true
                        lbl.Text = plr.Name .. ":\n  " .. table.concat(held, "\n  ")
                        lbl.Parent = scroll
                    end
                end

                if not any then
                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1, 0, 0, 30)
                    lbl.BackgroundTransparency = 1
                    lbl.TextColor3 = Color3.fromRGB(150, 150, 150)
                    lbl.Font = Enum.Font.Code
                    lbl.TextSize = 13
                    lbl.Text = "Ни у кого нет предметов"
                    lbl.Parent = scroll
                end
            end
        end
    end)
end

function Scanner.Enable()  Scanner.enabled = true  Scanner.window.Visible = true end
function Scanner.Disable() Scanner.enabled = false Scanner.window.Visible = false end
function Scanner.Toggle()  if Scanner.enabled then Scanner.Disable() else Scanner.Enable() end end

-- ============================================================
-- МОДУЛЬ: HIGHLIGHT
-- ============================================================
local Highlight = {}
Highlight.enabled = false

function Highlight.Init()
    spawn(function()
        while task.wait(0.3) do
            for _, plr in pairs(Players:GetPlayers()) do
                if plr == LP then continue end
                local char = plr.Character
                if not char then continue end

                local hrp = char:FindFirstChild("HumanoidRootPart")
                local head = char:FindFirstChild("Head")
                if not hrp then continue end

                local box  = hrp:FindFirstChild("EvilBox")
                local bill = head and head:FindFirstChild("EvilBill")

                if Highlight.enabled then
                    if not box then
                        local b = Instance.new("SelectionBox")
                        b.Name = "EvilBox"
                        b.Adornee = hrp
                        b.Color3 = Color3.fromRGB(255, 0, 0)
                        b.LineThickness = 0.2
                        b.Parent = hrp
                    end
                    if head and not bill then
                        local bb = Instance.new("BillboardGui")
                        bb.Name = "EvilBill"
                        bb.Size = UDim2.new(0, 200, 0, 40)
                        bb.StudsOffset = Vector3.new(0, 3, 0)
                        bb.AlwaysOnTop = true
                        bb.Parent = head

                        local t = Instance.new("TextLabel")
                        t.Size = UDim2.new(1, 0, 1, 0)
                        t.BackgroundTransparency = 1
                        t.TextColor3 = Color3.fromRGB(255, 50, 50)
                        t.Font = Enum.Font.GothamBold
                        t.TextSize = 18
                        t.TextStrokeTransparency = 0
                        t.Text = plr.Name
                        t.Parent = bb
                    end
                else
                    if box then box:Destroy() end
                    if bill then bill:Destroy() end
                end
            end
        end
    end)
end

function Highlight.Enable()  Highlight.enabled = true end
function Highlight.Disable() Highlight.enabled = false end
function Highlight.Toggle()  if Highlight.enabled then Highlight.Disable() else Highlight.Enable() end end

-- ============================================================
-- МОДУЛЬ: TELEPORT (правильный ТП вперёд)
-- ============================================================
local Teleport = {}

function Teleport.TP30S()
    local hrp = U.getHRP(LP)
    if not hrp then return end

    local start = hrp.CFrame.Position
    local target = U.teleportForward(30) -- исправлено: идём от HRP по горизонтали

    U.teleportEffect(start)
    hrp.CFrame = CFrame.new(target)
    U.teleportEffect(target)
    U.teleportSound(hrp)
end

function Teleport.TeleportToPortal(portal)
    if not portal or not portal.Parent then return end
    local hrp = U.getHRP(LP)
    if not hrp then return end

    local start = hrp.CFrame.Position
    local portalPos = portal.Position
    local normal = portal.CFrame.LookVector

    local finalPos
    if math.abs(normal.Y) > 0.7 then
        -- портал на полу/потолке
        local flat = Vector3.new(portalPos.X - start.X, 0, portalPos.Z - start.Z)
        if flat.Magnitude < 0.5 then
            flat = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
        end
        flat = flat.Unit
        finalPos = portalPos - flat * 5
        if normal.Y > 0 then
            finalPos = Vector3.new(finalPos.X, portalPos.Y + 3, finalPos.Z)
        else
            finalPos = Vector3.new(finalPos.X, portalPos.Y - 6, finalPos.Z)
        end
    else
        -- портал на стене
        finalPos = portalPos + normal * 5
        local ground = U.raycastGround(finalPos)
        finalPos = Vector3.new(finalPos.X, ground.Y, finalPos.Z)
    end

    -- Смотрим на портал
    local lookDir = portalPos - finalPos
    lookDir = Vector3.new(lookDir.X, 0, lookDir.Z)
    if lookDir.Magnitude < 0.1 then
        lookDir = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
    end
    lookDir = lookDir.Unit

    local finalCFrame = CFrame.lookAt(finalPos, finalPos + lookDir)

    U.teleportEffect(start)
    hrp.CFrame = finalCFrame
    U.teleportEffect(finalPos)
    U.teleportSound(hrp)
end

function Teleport.Init() end

-- ============================================================
-- МОДУЛЬ: SHIELD (не тронут)
-- ============================================================
local Shield = {}
Shield.enabled = false
Shield.part = nil

function Shield.Make()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if Shield.part then Shield.part:Destroy() end

    local sphere = Instance.new("Part")
    sphere.Name = "EvilShieldSphere"
    sphere.Shape = Enum.PartType.Ball
    sphere.Size = Vector3.new(10, 10, 10)
    sphere.Material = Enum.Material.ForceField
    sphere.Color = Color3.fromRGB(0, 200, 255)
    sphere.Transparency = 0.4
    sphere.CanCollide = false
    sphere.Massless = true
    sphere.CFrame = hrp.CFrame
    sphere.Parent = char

    local weld = Instance.new("Weld")
    weld.Part0 = hrp
    weld.Part1 = sphere
    weld.C0 = CFrame.new(0, 0, 0)
    weld.C1 = CFrame.new(0, 0, 0)
    weld.Parent = sphere

    local light = Instance.new("PointLight")
    light.Color = Color3.fromRGB(0, 200, 255)
    light.Brightness = 3
    light.Range = 15
    light.Parent = sphere

    Shield.part = sphere
end

function Shield.Destroy()
    if Shield.part then Shield.part:Destroy() Shield.part = nil end
end

function Shield.Enable()  Shield.enabled = true  Shield.Make() end
function Shield.Disable() Shield.enabled = false Shield.Destroy() end
function Shield.Toggle()  if Shield.enabled then Shield.Disable() else Shield.Enable() end end

function Shield.Init()
    LP.CharacterAdded:Connect(function()
        if Shield.enabled then task.wait(1) Shield.Make() end
    end)
end

