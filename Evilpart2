-- ============ SCANNER ============
local Scanner={enabled=false}
function Scanner.Init()
    local win=Instance.new("Frame")
    win.Size=UDim2.new(0,220,0,300)
    win.Position=UDim2.new(1,-230,0,100)
    win.BackgroundColor3=Color3.fromRGB(15,15,15)
    win.BorderSizePixel=2; win.BorderColor3=Color3.fromRGB(0,255,100)
    win.Visible=false; win.Parent=gui
    Scanner.win=win
    local cr=Instance.new("UICorner"); cr.CornerRadius=UDim.new(0,8); cr.Parent=win
    local t=Instance.new("TextLabel")
    t.Size=UDim2.new(1,0,0,28); t.BackgroundColor3=Color3.fromRGB(0,200,80)
    t.Text="СКАНЕР РУК"; t.TextColor3=Color3.new(1,1,1)
    t.Font=Enum.Font.GothamBold; t.TextSize=15; t.Parent=win
    local sc=Instance.new("ScrollingFrame")
    sc.Size=UDim2.new(1,-10,1,-38); sc.Position=UDim2.new(0,5,0,33)
    sc.BackgroundTransparency=1; sc.BorderSizePixel=0
    sc.ScrollBarThickness=6; sc.CanvasSize=UDim2.new(0,0,0,0)
    sc.AutomaticCanvasSize=Enum.AutomaticSize.Y; sc.Parent=win
    Scanner.sc=sc
    local lay=Instance.new("UIListLayout"); lay.Padding=UDim.new(0,4); lay.Parent=sc
    spawn(function()
        while task.wait(0.5) do
            if Scanner.enabled then
                for _,c in pairs(sc:GetChildren()) do
                    if c:IsA("TextLabel") then c:Destroy() end
                end
                local any=false
                for _,p in pairs(Players:GetPlayers()) do
                    local ch=p.Character; if not ch then continue end
                    local held={}
                    for _,t2 in pairs(ch:GetChildren()) do
                        if t2:IsA("Tool") then table.insert(held,"[РУКА] "..t2.Name) end
                    end
                    local bp=p:FindFirstChildOfClass("Backpack")
                    if bp then
                        for _,t2 in pairs(bp:GetChildren()) do
                            if t2:IsA("Tool") then table.insert(held,"[СУМКА] "..t2.Name) end
                        end
                    end
                    if #held>0 then
                        any=true
                        local l=Instance.new("TextLabel")
                        l.Size=UDim2.new(1,0,0,0); l.AutomaticSize=Enum.AutomaticSize.Y
                        l.BackgroundTransparency=1; l.TextColor3=Color3.fromRGB(0,255,100)
                        l.Font=Enum.Font.Code; l.TextSize=13
                        l.TextXAlignment=Enum.TextXAlignment.Left; l.TextWrapped=true
                        l.Text=p.Name..":\n  "..table.concat(held,"\n  ")
                        l.Parent=sc
                    end
                end
                if not any then
                    local l=Instance.new("TextLabel")
                    l.Size=UDim2.new(1,0,0,30); l.BackgroundTransparency=1
                    l.TextColor3=Color3.fromRGB(150,150,150); l.Font=Enum.Font.Code
                    l.TextSize=13; l.Text="Ни у кого нет предметов"; l.Parent=sc
                end
            end
        end
    end)
end
function Scanner.Enable() Scanner.enabled=true Scanner.win.Visible=true end
function Scanner.Disable() Scanner.enabled=false Scanner.win.Visible=false end
function Scanner.Toggle() if Scanner.enabled then Scanner.Disable() else Scanner.Enable() end end

-- ============ HIGHLIGHT ============
local Highlight={enabled=false}
function Highlight.Init()
    spawn(function()
        while task.wait(0.3) do
            for _,p in pairs(Players:GetPlayers()) do
                if p==LP then continue end
                local ch=p.Character; if not ch then continue end
                local hrp=ch:FindFirstChild("HumanoidRootPart")
                local head=ch:FindFirstChild("Head")
                if not hrp then continue end
                local box=hrp:FindFirstChild("EM_Box")
                local bill=head and head:FindFirstChild("EM_Bill")
                if Highlight.enabled then
                    if not box then
                        local b=Instance.new("SelectionBox")
                        b.Name="EM_Box"; b.Adornee=hrp
                        b.Color3=Color3.fromRGB(255,0,0); b.LineThickness=0.2
                        b.Parent=hrp
                    end
                    if head and not bill then
                        local bb=Instance.new("BillboardGui")
                        bb.Name="EM_Bill"; bb.Size=UDim2.new(0,200,0,40)
                        bb.StudsOffset=Vector3.new(0,3,0); bb.AlwaysOnTop=true
                        bb.Parent=head
                        local t=Instance.new("TextLabel")
                        t.Size=UDim2.new(1,0,1,0); t.BackgroundTransparency=1
                        t.TextColor3=Color3.fromRGB(255,50,50); t.Font=Enum.Font.GothamBold
                        t.TextSize=18; t.TextStrokeTransparency=0; t.Text=p.Name
                        t.Parent=bb
                    end
                else
                    if box then box:Destroy() end
                    if bill then bill:Destroy() end
                end
            end
        end
    end)
end
function Highlight.Enable() Highlight.enabled=true end
function Highlight.Disable() Highlight.enabled=false end
function Highlight.Toggle() if Highlight.enabled then Highlight.Disable() else Highlight.Enable() end end

-- ============ TELEPORT ============
local Teleport={}
function Teleport.TP30S()
    local hrp=U.getHRP(LP); if not hrp then return end
    local start=hrp.CFrame.Position
    local target=U.teleportForward(30)
    U.fx(start); hrp.CFrame=CFrame.new(target)
    U.fx(target); U.sound(hrp)
end
function Teleport.TeleportToPortal(portal)
    if not portal or not portal.Parent then return end
    local hrp=U.getHRP(LP); if not hrp then return end
    local start=hrp.CFrame.Position
    local pp=portal.Position
    local n=portal.CFrame.LookVector
    local final
    if math.abs(n.Y)>0.7 then
        local flat=Vector3.new(pp.X-start.X,0,pp.Z-start.Z)
        if flat.Magnitude<0.5 then
            flat=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
        end
        flat=flat.Unit
        final=pp-flat*5
        final=Vector3.new(final.X, n.Y>0 and pp.Y+3 or pp.Y-6, final.Z)
    else
        final=pp+n*5
        local g=U.rayGround(final)
        final=Vector3.new(final.X,g.Y,final.Z)
    end
    local ld=pp-final; ld=Vector3.new(ld.X,0,ld.Z)
    if ld.Magnitude<0.1 then
        ld=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
    end
    ld=ld.Unit
    U.fx(start); hrp.CFrame=CFrame.lookAt(final,final+ld)
    U.fx(final); U.sound(hrp)
end
function Teleport.Init() end

-- ============ SHIELD ============
local Shield={enabled=false,part=nil}
function Shield.Make()
    local ch=LP.Character; if not ch then return end
    local hrp=ch:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    if Shield.part then Shield.part:Destroy() end
    local s=Instance.new("Part")
    s.Name="EM_Shield"; s.Shape=Enum.PartType.Ball
    s.Size=Vector3.new(10,10,10); s.Material=Enum.Material.ForceField
    s.Color=Color3.fromRGB(0,200,255); s.Transparency=0.4
    s.CanCollide=false; s.Massless=true; s.CFrame=hrp.CFrame; s.Parent=ch
    local w=Instance.new("Weld")
    w.Part0=hrp; w.Part1=s; w.C0=CFrame.new(); w.C1=CFrame.new(); w.Parent=s
    local l=Instance.new("PointLight")
    l.Color=Color3.fromRGB(0,200,255); l.Brightness=3; l.Range=15; l.Parent=s
    Shield.part=s
end
function Shield.Destroy() if Shield.part then Shield.part:Destroy() Shield.part=nil end end
function Shield.Enable() Shield.enabled=true Shield.Make() end
function Shield.Disable() Shield.enabled=false Shield.Destroy() end
function Shield.Toggle() if Shield.enabled then Shield.Disable() else Shield.Enable() end end
function Shield.Init()
    LP.CharacterAdded:Connect(function()
        if Shield.enabled then task.wait(1) Shield.Make() end
    end)
end

C.modules.Scanner=Scanner
C.modules.Highlight=Highlight
C.modules.Teleport=Teleport
C.modules.Shield=Shield

Scanner.Init(); Highlight.Init(); Teleport.Init(); Shield.Init()

